<?xml version="1.0"?>
<ruleset name="Faria PMD Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>PMD ruleset for Faria financial analytics and risk assessment application.</description>

    <!--
        Best Practices
        Excluded (PMD 7 rule names):
          GuardLogStatement          - requires every log call to be wrapped in isXxxEnabled();
                                       too verbose for the project's logging convention.
          UnitTestShouldIncludeAssert - @SpringBootTest contextLoads() intentionally has no
                                       assertions; it verifies the context loads without error.
    -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="GuardLogStatement"/>
        <exclude name="UnitTestShouldIncludeAssert"/>
    </rule>

    <!--
        Error-Prone Patterns
        Excluded:
          MissingSerialVersionUID    - Spring-managed beans do not need to implement Serializable.
          TestClassWithoutTestCases  - ArchUnit @ArchTest fields are not recognised by PMD as
                                       test cases; HexagonalArchitectureTest is a valid test class.
    -->
    <rule ref="category/java/errorprone.xml">
        <exclude name="MissingSerialVersionUID"/>
        <exclude name="TestClassWithoutTestCases"/>
    </rule>

    <!-- Performance -->
    <rule ref="category/java/performance.xml"/>

    <!--
        Security — enforced strictly because this is a financial application.
        All rules in this category are included without exception.
    -->
    <rule ref="category/java/security.xml"/>

    <!--
        Intentionally omitted categories:
          codestyle.xml      - Checkstyle already covers formatting and naming.
          design.xml         - high false-positive rate; add targeted rules as the codebase matures.
          documentation.xml  - project convention is minimal comments (document WHY, not WHAT).
          multithreading.xml - not yet applicable; add when concurrent code is introduced.
    -->

</ruleset>
